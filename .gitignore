# ============================================================
# .gitignore - Gold Price Prediction
# ============================================================

# Datos (inmutables pero grandes / con licencia)
data/raw/
data/interim/
data/processed/
!data/raw/*.md
!data/README.md

# Modelos y artefactos generados
models/*.joblib
models/*.pkl
models/*.json
models/*.pt
!models/.gitkeep

# Entorno virtual
.venv/
venv/
env/

# Secretos
.env
*.env.local
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.coverage
htmlcov/

# Notebooks exportados
notebooks/*_executed.html
nbconvert/
.nb_tmp/
.nb_tmp_dl.ipynb

# Temporales de escrituras atomicas y experimentos
*.tmp
logs/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Datos descargados por scripts
data/external/

# CatBoost
catboost_info/
