# Copia este archivo a `.env` si quieres personalizar el arranque local.
# No contiene secretos.

# Usados por el objetivo `make api`.
API_HOST=127.0.0.1
API_PORT=8000

# Usado por docker compose para el puerto publicado en el host.
# API_HOST dentro del contenedor se fija a 0.0.0.0 en el Dockerfile/compose.
