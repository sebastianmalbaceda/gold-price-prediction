# Copia este archivo a `.env` si quieres personalizar el arranque local.
# No contiene secretos reales.

# Usados por el objetivo `make api`.
API_HOST=127.0.0.1
API_PORT=8000

# Usado por docker compose para el puerto publicado en el host.
# API_HOST dentro del contenedor se fija a 0.0.0.0 en el Dockerfile/compose.

# Controles opcionales de la API. Definir GOLD_API_KEY protege los endpoints de
# inferencia con la cabecera X-API-Key; vacío conserva el comportamiento local abierto.
GOLD_API_KEY=
API_MAX_BODY_BYTES=131072
