# Copia este archivo a `.env` y ajusta los valores.
# El repositorio NO contiene secretos; las variables de entorno permiten
# configurar la API sin tocar código.

# Host y puerto de la API (por defecto local)
API_HOST=127.0.0.1
API_PORT=8000

# Versión del modelo servida (debe coincidir con configs/config.yaml)
MODEL_VERSION=1.0.0

# Umbral de alerta de monitorización (múltiplo del MAE de test)
MONITOR_ALERT_MULTIPLIER=1.5
